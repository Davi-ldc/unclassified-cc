{
  "name": "unclassified-cc",
  "version": "0.2.0",
  "description": "API-key gateway with an OpenCode-style HTTP privacy profile for Claude Code",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "setup": "bun src/scripts/setup.ts init",
    "add-client": "bun src/scripts/setup.ts add-client",
    "generate-token": "bun src/scripts/generate-token.ts",
    "test": "tsc --project tsconfig.tests.json && tsx --test tests/*.test.ts",
    "test:client": "tsx tests/client-smoke.ts"
  },
  "dependencies": {
    "https-proxy-agent": "^9.1.0",
    "jsonc-parser": "^3.3.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
